BOT_TOKEN=вставьте_сюда_токен_от_BotFather

# Юзернейм бота без @ (например DogWalkBot) — нужен api-сервису только чтобы
# собрать инвайт-ссылку https://t.me/<bot>?start=invite_<code>.
BOT_USERNAME=вставьте_сюда_юзернейм_бота

# На Railway эта переменная появляется автоматически при подключённом плагине Postgres.
# Для локального запуска укажите строку подключения к своей базе, например:
# postgresql://user:password@localhost:5432/dog_bot
DATABASE_URL=postgresql://user:password@localhost:5432/dog_bot

# Публичный URL api-сервиса на Railway (он же отдаёт статику Mini App) — нужен
# боту, чтобы собрать WebApp-кнопку. Локально — адрес uvicorn (http://localhost:8000).
MINIAPP_URL=https://your-api-service.up.railway.app
